{
  "name": "issue-runner-t3",
  "version": "0.1.0",
  "description": "Issue Runner for T3 Code",
  "type": "module",
  "license": "MIT",
  "bin": {
    "issue-runner-t3": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills/issue-runner-t3"
  ],
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.release.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/**/*.test.*\"",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "issue-runner-core": "1.0.12",
    "@modelcontextprotocol/sdk": "1.32.2",
    "open": "11.0.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.70.0",
    "globals": "^16.5.0"
  },
  "packageManager": "npm@11.6.2",
  "keywords": [
    "issue-runner",
    "t3",
    "t3-code",
    "cli",
    "mcp",
    "github-issues",
    "workflow-automation",
    "ai-agents",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuddyLabsCo/issue-runner-t3.git"
  },
  "homepage": "https://github.com/BuddyLabsCo/issue-runner-t3#readme",
  "bugs": {
    "url": "https://github.com/BuddyLabsCo/issue-runner-t3/issues"
  }
}
